<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Midterm AI Dashboard"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart App &amp; Widgets Manager"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="16dp"
        app:itemIconTint="#4F46E5"
        app:itemTextColor="#4F46E5"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Content Containers for Tabs -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        android:layout_below="@id/header_bar"
        android:padding="16dp">

        <!-- 1. Clock Tab Layout -->
        <LinearLayout
            android:id="@+id/layout_tab_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clock_card"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh:mm:ss a"
                    android:format24Hour="HH:mm:ss"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, dd MMMM yyyy"
                    android:format24Hour="EEEE, dd MMMM yyyy"
                    android:textColor="#94A3B8"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒 Home Screen Clock Widget"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Ghim Clock Widget ra Màn hình chính để xem giờ tự động cập nhật mọi lúc!"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 2. Weather Tab Layout -->
        <LinearLayout
            android:id="@+id/layout_tab_weather"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_weather_card"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 TP. Hồ Chí Minh"
                    android:textColor="#E0F2FE"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/main_tv_weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/main_tv_weather_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang lấy thông tin thời tiết..."
                    android:textColor="#F0F9FF"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/main_btn_weather_refresh"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Cập nhật Thời tiết qua API"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                app:backgroundTint="#0284C7"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <!-- 3. To-Do List Tab Layout -->
        <RelativeLayout
            android:id="@+id/layout_tab_todo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#121212"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_todo_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reminders_title"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_tasks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/tv_todo_header"
                android:layout_above="@id/todo_add_bar"
                android:clipToPadding="false"
                android:background="#121212"
                android:layout_marginHorizontal="8dp" />

            <!-- Dark Theme Bottom Add Bar (Like Samsung Reminder) -->
            <LinearLayout
                android:id="@+id/todo_add_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="10dp"
                android:paddingHorizontal="16dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_dark_pill"
                android:elevation="4dp">

                <EditText
                    android:id="@+id/edit_task_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/add_reminder_hint"
                    android:textColorHint="#8E8E93"
                    android:textColor="#FFFFFF"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/icon_mic"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:layout_marginEnd="8dp"
                    app:tint="#8E8E93" />

                <TextView
                    android:id="@+id/btn_add_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_add"
                    android:textColor="#0A84FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
        </RelativeLayout>

        <!-- 4. Music Player Tab Layout -->
        <LinearLayout
            android:id="@+id/layout_tab_music"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_music_card"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:contentDescription="Music Icon"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/main_tv_music_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Music Player"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/main_tv_music_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa phát nhạc"
                    android:textColor="#FBCFE8"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="32dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/main_btn_music_prev"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="Bài trước"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/main_btn_music_play"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="Phát / Tạm dừng"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:backgroundTint="#DB2777"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/main_btn_music_next"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="Bài tiếp"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- 5. Calendar Tab Layout -->
        <RelativeLayout
            android:id="@+id/layout_tab_calendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_calendar_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Schedule"
                android:textColor="#041E49"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_alignParentTop="true"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list_events"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/tv_calendar_header"
                android:layout_above="@id/calendar_add_card"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calendar_add_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                app:cardBackgroundColor="#F8FAFC"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edit_event_title"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_clock_card"
                            android:backgroundTint="#FFFFFF"
                            android:hint="New Event Title"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textSize="15sp"
                            android:textColor="#041E49" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_event"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Add"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            app:backgroundTint="#0A56D1"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <EditText
                            android:id="@+id/edit_event_date"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_clock_card"
                            android:backgroundTint="#FFFFFF"
                            android:hint="Date (e.g., Oct 26)"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edit_event_time"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_clock_card"
                            android:backgroundTint="#FFFFFF"
                            android:hint="Time (09:00 AM)"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="16dp"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

    </FrameLayout>

</RelativeLayout>
